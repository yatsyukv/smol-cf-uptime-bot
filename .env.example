# Copy to .env (gitignored) or run `npm run setup`.
#
# CLOUDFLARE_API_TOKEN  — Wrangler deploy (Workers Scripts Edit + Workers KV Storage Edit)
# TELEGRAM_BOT_TOKEN    — from BotFather; also set on the Worker via wrangler secret put
# TELEGRAM_CHAT_ID      — group chat id from `npm run chat-id`

CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CLOUDFLARE_ACCOUNT_ID=
# WORKER_NAME=smol-cf-uptime
# SUMMARY_TZ=UTC
# SUMMARY_HOUR=9
