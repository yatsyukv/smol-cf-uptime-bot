# Copy to ~/.config/winwin-uptime.env and fill in. Never commit the filled file.
#
# CLOUDFLARE_API_TOKEN  — Wrangler deploy (API token with Workers + KV edit)
# TELEGRAM_BOT_TOKEN    — from BotFather; also set on the Worker via wrangler secret put
# TELEGRAM_CHAT_ID      — group chat id from `npm run chat-id`

CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CLOUDFLARE_ACCOUNT_ID=   # only if the token can see more than one account
